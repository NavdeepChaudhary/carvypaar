# CarVypaar reverse proxy: automatic HTTPS, one origin for the web app and the API.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# API, WebSockets (/api/ws/*) and uploaded photos -> FastAPI
	@api path /api/* /uploads/*
	handle @api {
		reverse_proxy backend:8000 {
			# Real client IP for rate limiting / lockouts (backend trusts this proxy only).
			header_up X-Forwarded-For {remote_host}
			header_up X-Request-ID {http.request.uuid}
		}
	}

	# Interactive API docs are disabled in production by the app; never proxy them.
	@docs path /docs* /openapi.json /redoc*
	respond @docs 404

	# Everything else -> Next.js
	handle {
		reverse_proxy frontend:3000
	}

	header {
		-Server
		-X-Powered-By
	}

	log {
		output stdout
		format json
	}
}

# Redirect www to the apex domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
