# Copy to .env and change the secrets. Used by docker-compose AND by the backend
# when run locally (backend reads ../.env).

# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Security ----
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
# New listings wait for admin approval at /admin (false = publish instantly)
REQUIRE_LISTING_APPROVAL=true

# ---- PostgreSQL (docker-compose) ----
POSTGRES_USER=carvypaar
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=carvypaar
# DATABASE_URL is built by docker-compose from the values above.
# Leave it unset for local dev to use SQLite (backend/carvypaar.db).
# DATABASE_URL=postgresql+psycopg://carvypaar:change-this-db-password@localhost:5432/carvypaar

# ---- Storage ----
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=8

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Sign-in (Clerk) ----
# From https://dashboard.clerk.com -> your app -> API keys. Without them nobody can sign in.
# The website needs the same publishable key as NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (frontend/.env.local).
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
