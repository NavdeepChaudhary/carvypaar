# CarvyPaar production settings. Copy to .env.production (never commit it).
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ---- Public address ----
DOMAIN=carvypaar.example.com          # DNS A/AAAA record must point at this server
ACME_EMAIL=ops@example.com            # Let's Encrypt account / expiry notices

# ---- Secrets (generate fresh values, never reuse dev ones) ----
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=

# ---- Database ----
POSTGRES_USER=carvypaar
POSTGRES_DB=carvypaar

# ---- App behaviour ----
REQUIRE_LISTING_APPROVAL=true
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO
WEB_CONCURRENCY=2                     # API worker processes (Redis keeps them in sync)

# ---- Sign-in (Clerk, required) ----
# https://dashboard.clerk.com -> your app -> API keys (use the Production instance's keys).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Set automatically by docker-compose.prod.yml (listed here for reference):
#   ENVIRONMENT=production  COOKIE_SECURE=true  CORS_ORIGINS=https://$DOMAIN
#   DATABASE_URL=postgresql+psycopg://...@db:5432/...  REDIS_URL=redis://redis:6379/0
